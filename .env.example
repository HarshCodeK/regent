# Copy to .env and fill in. Nothing here is committed.
REGENT_DB_PATH=./.regent/regent.db
# Bootstrap key for the admin endpoints. Change it.
REGENT_ADMIN_KEY=regent-dev-admin
# Which provider serves requests by default (stub = fully offline, no key needed).
REGENT_DEFAULT_PROVIDER=stub
REGENT_DEFAULT_MODEL=stub-small
# Real provider keys - optional. Without them the gateway runs in stub mode.
GROQ_API_KEY=
